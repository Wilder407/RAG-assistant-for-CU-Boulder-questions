# Copy this file to .env and replace the placeholder with your actual key.
# .env is listed in .gitignore — never commit your real key.
#
# Get a free Groq API key (no credit card required) at:
# https://console.groq.com

GROQ_API_KEY=your_key_here

# Optional — overrides the default generation model set in query.py.
# Leave unset to use the current default (openai/gpt-oss-120b).
# Set this if Groq decommissions that model; check the current list at
# https://console.groq.com/docs/models and deprecations at
# https://console.groq.com/docs/deprecations
#
# GROQ_MODEL=openai/gpt-oss-120b
